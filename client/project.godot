; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Zenith"
config/version="0.2.0"
config/description="3D client for a running Factorio game, via the factorio-3d-bridge mod."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.png"
config/windows_native_icon="res://icon.ico"
config/project_settings_override="user://engine.cfg"

[autoload]

Bridge="*res://scripts/net/bridge.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[editor_plugins]

enabled=PackedStringArray("res://addons/zenith_export/plugin.cfg")

[rendering]

driver/threads/thread_model=1

textures/default_filters/anisotropic_filtering_level=4
textures/vram_compression/compress_with_gpu=false
limits/global_shader_variables/buffer_size=4194304

[shader_globals]

f3d_ground={
"type": "sampler2D",
"value": ""
}
f3d_ground_on={
"type": "float",
"value": 0.0
}
f3d_ground_rect={
"type": "vec4",
"value": Vector4(0, 0, 1, 0)
}
f3d_anim_time={
"type": "vec2",
"value": Vector2(0, 0)
}
f3d_mover_clock={
"type": "vec4",
"value": Vector4(0, 0, 60, 0)
}
f3d_movers={
"type": "sampler2D",
"value": ""
}
f3d_belt_records={
"type": "sampler2DArray",
"value": ""
}
f3d_belt_clock={
"type": "float",
"value": 0.0
}
f3d_belt_lattice={
"type": "sampler2DArray",
"value": ""
}
f3d_belt_mask={
"type": "sampler2D",
"value": ""
}
f3d_belt_lattice_on={
"type": "float",
"value": 0.0
}
f3d_frame_dt={
"type": "float",
"value": 0.0
}
f3d_grass={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
f3d_grass_wind={
"type": "float",
"value": 0.0
}
f3d_decor_mask={
"type": "sampler2D",
"value": ""
}
f3d_decor_mask_on={
"type": "float",
"value": 0.0
}
f3d_look_ground_specular={
"type": "float",
"value": 1.0
}
f3d_look_model_fill={
"type": "float",
"value": 0.0
}
f3d_look_roughness_min={
"type": "float",
"value": 0.0
}

[xr]

openxr/enabled=false
openxr/startup_alert=false
shaders/enabled=true
