; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Zenith"
config/version="0.3.0"
config/description="3D client for a running Factorio game, via the factorio-3d-bridge mod."
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.png"
config/windows_native_icon="res://icon.ico"
config/project_settings_override="user://engine.cfg"

[autoload]

Bridge="*res://scripts/net/bridge.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[editor_plugins]

enabled=PackedStringArray("res://addons/zenith_export/plugin.cfg")

[rendering]

driver/threads/thread_model=1

textures/default_filters/anisotropic_filtering_level=4
textures/vram_compression/compress_with_gpu=false
limits/global_shader_variables/buffer_size=4194304
limits/cluster_builder/max_clustered_elements=1024

[shader_globals]

f3d_nature_grain={
"type": "sampler2DArray",
"value": ""
}
f3d_time={
"type": "float",
"value": 0.0
}
