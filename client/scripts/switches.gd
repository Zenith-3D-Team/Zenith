static var _addon_switches: Dictionary = {}
static var _cached_args := PackedStringArray()
static var _has_cache := false


static func args() -> PackedStringArray:
	if not _has_cache:
		_cached_args = OS.get_cmdline_user_args()
		_has_cache = true
	return _cached_args


static func set_test_args(custom: PackedStringArray) -> void:
	_cached_args = custom
	_has_cache = true


static func reset_cache() -> void:
	_cached_args = PackedStringArray()
	_has_cache = false


static func has(flag: String) -> bool:
	return args().has(flag)


static func value(flag: String, default_val := "") -> String:
	var prefix := flag + "="
	for arg: String in args():
		if arg.begins_with(prefix):
			return arg.substr(prefix.length())
	return default_val


static func on(flag: String, default_val := true) -> bool:
	var prefix := flag + "="
	var result := default_val
	for arg: String in args():
		if arg == flag:
			result = true
		elif arg.begins_with(prefix):
			var v := arg.substr(prefix.length()).to_lower()
			if v == "off" or v == "false" or v == "0":
				result = false
			elif v == "on" or v == "true" or v == "1":
				result = true
	return result


static func _flag_name(arg: String) -> String:
	var eq := arg.find("=")
	if eq >= 0:
		return arg.substr(0, eq)
	return arg


static func register_addon_switch(flag: String) -> void:
	var name := _flag_name(flag.strip_edges())
	if name.is_empty():
		return
	if not name.begins_with("--"):
		name = "--" + name
	_addon_switches[name] = true


static func is_known(arg: String) -> bool:
	if not arg.begins_with("--"):
		return true
	var name := _flag_name(arg)
	if name == "--" or name.is_empty():
		return true
	if REGISTRY.has(name) or _addon_switches.has(name) or PASSTHROUGH_FLAGS.has(name):
		return true
	for prefix: String in PASSTHROUGH_PREFIXES:
		if name.begins_with(prefix):
			return true
	return false


static func unknown_args(args: PackedStringArray) -> PackedStringArray:
	var out := PackedStringArray()
	var seen: Dictionary = {}
	for arg: String in args:
		if arg.begins_with("--") and not is_known(arg) and not seen.has(arg):
			seen[arg] = true
			out.append(arg)
	return out


static func warn_unknown(args: PackedStringArray) -> void:
	for arg: String in unknown_args(args):
		print("switches: unknown CLI flag: %s" % arg)
