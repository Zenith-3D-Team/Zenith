#!/usr/bin/env python
# The upscalers library (ZenithUpscalerCaps: capability checks for AMD FSR 4.1, AMD FSR 3.1 and NVIDIA DLSS) as its
# own GDExtension, never a dependency of belt_sim. godot-cpp (its 4.5 branch) goes in ../godot-cpp, as for
# belt_sim; docs/RUNNING.md says how to build.
#   scons target=template_release        (from a shell with MSVC's vcvars64; build.bat does that)
import os

# godot_cpp=<dir>: a godot-cpp built elsewhere (another worktree's copy).
godot_cpp = ARGUMENTS.get("godot_cpp", "../godot-cpp")
env = SConscript(os.path.join(godot_cpp, "SConstruct"))
env.Append(CPPPATH=["src/"])

# ffx_sdk=<dir>: AMD FSR SDK 2.4.0 as AMD lays it out (Kits/FidelityFX/api/include, .../upscalers/include), for
# ZenithFsrUpscaler's API headers (MIT). Never committed: by default the git-ignored art-src/vendor-runtimes/amd/
# fsr-sdk-2.4.0, looked for in this checkout and the folders above it (a worktree's main checkout). Without it the
# library still builds, ZenithFsrUpscaler saying it was built without AMD's SDK. AMD's DLLs are loaded at run time,
# never linked.
def find_ffx_sdk():
	given = ARGUMENTS.get("ffx_sdk", "")
	if given:
		return os.path.abspath(given)
	here = os.path.abspath(Dir("#").abspath)
	while True:
		candidate = os.path.join(here, "art-src", "vendor-runtimes", "amd", "fsr-sdk-2.4.0")
		if os.path.isdir(candidate):
			return candidate
		parent = os.path.dirname(here)
		if parent == here:
			return ""
		here = parent
ffx_sdk = find_ffx_sdk()
ffx_api = os.path.join(ffx_sdk, "Kits", "FidelityFX", "api", "include") if ffx_sdk else ""
ffx_upscale = os.path.join(ffx_sdk, "Kits", "FidelityFX", "upscalers", "include") if ffx_sdk else ""
if env["platform"] == "windows" and not env.get("use_mingw"):
	env.Append(CCFLAGS=["/O2", "/Oi", "/GL"], LINKFLAGS=["/LTCG"])
	# As belt_sim: the DLL must not carry where it was built (/d1trimfile cuts these folders off __FILE__).
	native_root = os.path.abspath(os.path.join(Dir("#").abspath, ".."))
	trim_roots = {native_root, os.path.dirname(os.path.abspath(godot_cpp))}
	env.Append(CCFLAGS=["/d1trimfile:" + r + ("\\\\" if " " in r else "\\") for r in sorted(trim_roots)])
elif env["platform"] == "linux":
	native_root = os.path.abspath(os.path.join(Dir("#").abspath, ".."))
	trim_roots = {native_root, os.path.dirname(os.path.abspath(godot_cpp))}
	env.Append(CCFLAGS=["-ffile-prefix-map=" + r.rstrip("/") + "/=" for r in sorted(trim_roots)])
lib_env = env.Clone()
if env["platform"] == "windows" and ffx_api and os.path.isfile(os.path.join(ffx_upscale, "ffx_upscale.h")):
	print("upscalers: AMD FSR SDK headers from " + ffx_sdk)
	lib_env.Append(CPPPATH=[ffx_api, ffx_upscale], CPPDEFINES=["ZENITH_FFX"])
	if not env.get("use_mingw"):
		trim = os.path.dirname(ffx_sdk)
		lib_env.Append(CCFLAGS=["/d1trimfile:" + trim + ("\\\\" if " " in trim else "\\")])
else:
	print("upscalers: no AMD FSR SDK headers (ffx_sdk=): ZenithFsrUpscaler built without AMD FSR")
if env["platform"] == "windows" and not env.get("use_mingw"):
	lib_env.Append(CCFLAGS=["/Zi", "/FS"], LINKFLAGS=["/DEBUG", "/PDBALTPATH:%_PDB%", "/OPT:REF", "/OPT:ICF"])
# sl_sdk=<dir>: NVIDIA Streamline v2.14.16's MIT headers (<dir>/include/sl.h), for ZenithDlssUpscaler. Never committed:
# by default the git-ignored art-src/vendor-runtimes/streamline/v2.14.16, looked for here and in the folders above (a
# worktree's main checkout). Without them ZenithDlssUpscaler says it was built without Streamline. Nothing of
# NVIDIA's is linked: our own Streamline build's DLLs are loaded at run time (tools/dlss/README.md).
def find_sl_sdk():
	given = ARGUMENTS.get("sl_sdk", "")
	if given:
		return os.path.abspath(given)
	here = os.path.abspath(Dir("#").abspath)
	while os.path.dirname(here) != here:
		candidate = os.path.join(here, "art-src", "vendor-runtimes", "streamline", "v2.14.16")
		if os.path.isfile(os.path.join(candidate, "include", "sl.h")):
			return candidate
		here = os.path.dirname(here)
	return ""
sl_sdk = find_sl_sdk()
if env["platform"] == "windows" and sl_sdk:
	print("upscalers: Streamline headers from " + sl_sdk)
	lib_env.Append(CPPPATH=[os.path.join(sl_sdk, "include")], CPPDEFINES=["ZENITH_SL"])
	if not env.get("use_mingw"):
		trim = os.path.dirname(sl_sdk)
		lib_env.Append(CCFLAGS=["/d1trimfile:" + trim + ("\\\\" if " " in trim else "\\")])
else:
	print("upscalers: no Streamline headers (sl_sdk=): ZenithDlssUpscaler built without DLSS")
sources = Glob("src/*.cpp")
name = "upscalers{}{}".format(env["suffix"], env["SHLIBSUFFIX"])
library = lib_env.SharedLibrary("../bin/" + name, source=sources)
Default(library)
