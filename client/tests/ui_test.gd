	# The worker path: messages wait for a job, chunks are made within the frame budget.
	lanes.sync = false
	lanes.handle({"t": "bfar", "cx": 4, "cy": 1, "l": [130 * 256, 40 * 256, 0, 1, 2], "c": [4, 3]})
	lanes.handle({"t": "bfar", "cx": 4, "cy": 1, "l": [130 * 256, 40 * 256, 0, 1, 2], "c": [2, 3]})
