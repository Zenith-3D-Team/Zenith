	var far_seed: int = BeltLanesScript.Job.slot_seed(100 * 256, 40 * 256, 0, 0)
	var far_cs: Array = []
	var far_turn_ok: bool = absf(ItemCardsScript.turn_for(far_seed)) > 0.0001
	for j in range(0, 4):
