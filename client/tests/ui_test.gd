	BeltLanesScript.auto_cap = cap_was
	lanes.bridge_work = -1.0
	lanes.covered = covered_was
	check(is_equal_approx(work_heard, 1500.0) and auto_caps == [7200, 7200, 6000, 4800, 6000],
