	"ambient_energy_scale", "ambient_tint_amount", "sky_tint_amount", "star_visibility_scale",
	"cloud_cover", "cloud_alpha_scale", "cloud_shadow_scale", "cloud_darkness",
	"cloud_tint_amount", "wind_strength", "wind_audio", "fog_density_add",
	"fog_color_amount", "haze_strength", "god_rays_scale",
	"rain_intensity", "splash_rate", "target_wetness", "target_puddles", "ripple_strength",
	"rain_audio", "storm_intensity", "lightning_rate",
]

const COLOR_KEYS := [
	"sun_color_tint", "ambient_tint", "sky_zenith_tint", "sky_horizon_tint",
	"cloud_tint", "fog_color", "haze_color",
]


static func choices() -> Array:
	var out: Array = []
	for id: String in ORDER:
		var p: Dictionary = PRESETS[id]
		out.append([str(p["label"]), id])
	return out


static func label_of(id: String) -> String:
	var p: Dictionary = PRESETS.get(id, {})
	return str(p.get("label", id))


static func blend(from_id: String, to_id: String, t: float) -> Dictionary:
	var a: Dictionary = PRESETS.get(from_id, PRESETS["fair"])
	var b: Dictionary = PRESETS.get(to_id, a)
	var u := smoothstep(0.0, 1.0, clampf(t, 0.0, 1.0))
	var out := {}
	for k: String in FLOAT_KEYS:
		out[k] = lerpf(float(a[k]), float(b[k]), u)
	for k: String in COLOR_KEYS:
		out[k] = (a[k] as Color).lerp(b[k] as Color, u)
	out["wind"] = (a["wind"] as Vector2).lerp(b["wind"] as Vector2, u)
	return out
