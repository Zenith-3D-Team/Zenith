Zenith patch 0003: inputs for a custom upscaler (RenderData.get_upscale_inputs).

During a ViewportUpscaler's render callback, RenderData.get_upscale_inputs() returns what Godot's FSR 2.2 gets
and no bound API exposes: the colour, depth, velocity, output and exposure textures, render and output size,
jitter (render pixels and NDC), a reset flag (new or resized buffers), near/far, vertical FOV, orthogonal,
delta time and the reprojection matrix. Zenith's own work, vendor-free, MIT like Godot.

diff --git a/servers/rendering/renderer_rd/forward_clustered/render_forward_clustered.cpp b/servers/rendering/renderer_rd/forward_clustered/render_forward_clustered.cpp
index 3b65755..a961919 100644
--- a/servers/rendering/renderer_rd/forward_clustered/render_forward_clustered.cpp
+++ b/servers/rendering/renderer_rd/forward_clustered/render_forward_clustered.cpp
@@ -2469,8 +2469,47 @@ void RenderForwardClustered::_render_scene(RenderDataRD *p_render_data, const Co
 
 	if (rb_data.is_valid() && (using_upscaling || using_taa)) {
 		if (scale_type == SCALE_CUSTOM) {
+			RID exposure;
+			if (RSG::camera_attributes->camera_attributes_uses_auto_exposure(p_render_data->camera_attributes)) {
+				exposure = luminance->get_current_luminance_buffer(rb);
+			}
+			real_t fov = p_render_data->scene_data->cam_projection.get_fov();
+			real_t aspect = p_render_data->scene_data->cam_projection.get_aspect();
+			Projection correction;
+			correction.set_depth_correction(true, true, false);
+			const Projection &prev_proj = p_render_data->scene_data->prev_cam_projection;
+			const Projection &cur_proj = p_render_data->scene_data->cam_projection;
+			const Transform3D &prev_transform = p_render_data->scene_data->prev_cam_transform;
+			const Transform3D &cur_transform = p_render_data->scene_data->cam_transform;
+
+			Dictionary inputs;
+			// View 0's textures (an upscaler for stereo reads the layers from the render buffers).
+			inputs["color"] = rb->get_internal_texture(0);
+			inputs["depth"] = rb->get_depth_texture(0);
+			inputs["velocity"] = rb->has_velocity_buffer(false) ? rb->get_velocity_buffer(false, 0) : RID();
+			inputs["output"] = rb->get_upscaled_layer(0);
+			inputs["exposure"] = exposure;
+			inputs["render_size"] = rb->get_internal_size();
+			inputs["output_size"] = rb->get_target_size();
+			// Jitter in render pixels as FSR 2.2 gets it, and Godot's own (NDC) value.
+			inputs["jitter"] = p_render_data->scene_data->taa_jitter * Vector2(rb->get_internal_size()) * 0.5f;
+			inputs["jitter_ndc"] = p_render_data->scene_data->taa_jitter;
+			inputs["jitter_phase_count"] = RSG::viewport->viewport_upscaler_get_jitter_phase_count(custom_upscaler);
+			inputs["reset"] = rb->custom_upscale_reset;
+			inputs["z_near"] = p_render_data->scene_data->z_near;
+			inputs["z_far"] = p_render_data->scene_data->z_far;
+			inputs["fovy"] = p_render_data->scene_data->cam_projection.get_fovy(fov, 1.0 / aspect);
+			inputs["orthogonal"] = p_render_data->scene_data->cam_projection.is_orthogonal();
+			inputs["delta_time"] = float(time_step);
+			inputs["reprojection"] = (correction * prev_proj) * prev_transform.affine_inverse() * cur_transform * (correction * cur_proj).inverse();
+			rb->custom_upscale_reset = false;
+
+			p_render_data->upscale_inputs = inputs;
+			RD::get_singleton()->draw_command_begin_label("Custom Upscaler");
 			Callable callback = RSG::viewport->viewport_upscaler_get_render_callback(custom_upscaler);
 			callback.call(p_render_data);
+			RD::get_singleton()->draw_command_end_label();
+			p_render_data->upscale_inputs = Dictionary();
 		} else if (scale_type == SCALE_FSR2) {
 			rb_data->ensure_fsr2(fsr2_effect);
 
