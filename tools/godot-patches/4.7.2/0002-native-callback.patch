index 5afb1b7..7c3d5fc 100644
--- a/drivers/d3d12/rendering_device_driver_d3d12.cpp
+++ b/drivers/d3d12/rendering_device_driver_d3d12.cpp
@@ -5634,6 +5634,80 @@ uint64_t RenderingDeviceDriverD3D12::timestamp_query_result_to_time(uint64_t p_r
 	return p_result / (double)device_limits.timestamp_frequency * 1000000000.0;
 }
 
+/******************/
+/**** CALLBACK ****/
+/******************/
+
+bool RenderingDeviceDriverD3D12::command_native_callback_begin(CommandBufferID p_cmd_buffer, VectorView<TextureID> p_textures, VectorView<TextureLayout> p_layouts, NativeCallbackInfo &r_info, uint64_t *r_resources, uint32_t *r_states) {
+	CommandBufferInfo *cmd_buf_info = (CommandBufferInfo *)p_cmd_buffer.id;
+	const bool enhanced = barrier_capabilities.enhanced_barriers_supported;
+
+	if (!enhanced) {
+		// Legacy barriers: the render graph's barriers don't reach D3D12, states are set lazily on use, so set them here.
+		for (uint32_t i = 0; i < p_textures.size(); i++) {
+			TextureInfo *tex_info = (TextureInfo *)p_textures[i].id;
+			D3D12_RESOURCE_STATES wanted_state = D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE | D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE;
+			switch (p_layouts[i]) {
+				case TEXTURE_LAYOUT_STORAGE_OPTIMAL:
+					wanted_state = D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+					break;
+				case TEXTURE_LAYOUT_COPY_SRC_OPTIMAL:
+					wanted_state = D3D12_RESOURCE_STATE_COPY_SOURCE;
+					break;
+				case TEXTURE_LAYOUT_COPY_DST_OPTIMAL:
+					wanted_state = D3D12_RESOURCE_STATE_COPY_DEST;
+					break;
+				default:
+					break;
+			}
+			uint32_t planes = 1;
+			if ((tex_info->desc.Flags & D3D12_RESOURCE_FLAG_ALLOW_DEPTH_STENCIL)) {
+				planes = format_get_plane_count(tex_info->format);
+			}
+			for (uint32_t l = 0; l < tex_info->layers; l++) {
+				for (uint32_t m = 0; m < tex_info->mipmaps; m++) {
+					uint32_t subresource = D3D12CalcSubresource(tex_info->base_mip + m, tex_info->base_layer + l, 0, tex_info->desc.MipLevels, tex_info->desc.ArraySize());
+					_resource_transition_batch(cmd_buf_info, tex_info, subresource, planes, wanted_state);
+				}
+			}
+		}
+		_resource_transitions_flush(cmd_buf_info);
+	}
+
+	for (uint32_t i = 0; i < p_textures.size(); i++) {
+		const TextureInfo *tex_info = (const TextureInfo *)p_textures[i].id;
+		r_resources[i] = (uint64_t)tex_info->resource;
+		if (enhanced) {
+			// The render graph has already moved the texture to the layout of its usage.
+			r_states[i] = (uint32_t)_rd_texture_layout_to_d3d12_barrier_layout(p_layouts[i]);
+		} else {
+			uint32_t subresource = D3D12CalcSubresource(tex_info->base_mip, tex_info->base_layer, 0, tex_info->desc.MipLevels, tex_info->desc.ArraySize());
+			r_states[i] = (uint32_t)tex_info->states_ptr->subresource_states[subresource];
+		}
+	}
+
+	r_info.api = NATIVE_API_D3D12;
+	r_info.command_list = (uint64_t)cmd_buf_info->cmd_list.Get();
+	r_info.barrier_model = enhanced ? NATIVE_BARRIERS_ENHANCED_LAYOUTS : NATIVE_BARRIERS_LEGACY_STATES;
+	r_info.resource_count = p_textures.size();
+	r_info.resources = r_resources;
+	r_info.states = r_states;
+	return true;
+}
+
+void RenderingDeviceDriverD3D12::command_native_callback_end(CommandBufferID p_cmd_buffer) {
+	// The native code may have set its own descriptor heaps, root signatures, pipelines and dynamic state.
+	CommandBufferInfo *cmd_buf_info = (CommandBufferInfo *)p_cmd_buffer.id;
+	cmd_buf_info->graphics_pso = nullptr;
+	cmd_buf_info->graphics_root_signature_crc = 0;
+	cmd_buf_info->compute_pso = nullptr;
+	cmd_buf_info->compute_root_signature_crc = 0;
+	cmd_buf_info->nir_graphics_runtime_data_root_param_idx = UINT32_MAX;
+	cmd_buf_info->nir_compute_runtime_data_root_param_idx = UINT32_MAX;
+	cmd_buf_info->pending_dyn_params = true;
+	cmd_buf_info->descriptor_heaps_set = false;
+}
+
 void RenderingDeviceDriverD3D12::command_timestamp_query_pool_reset(CommandBufferID p_cmd_buffer, QueryPoolID p_pool_id, uint32_t p_query_count) {
 }
 
