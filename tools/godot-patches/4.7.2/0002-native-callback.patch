 	ClassDB::bind_method(D_METHOD("get_driver_resource", "resource", "rid", "index"), &RenderingDevice::get_driver_resource);
+	ClassDB::bind_method(D_METHOD("native_callback_add", "callback", "userdata", "textures", "usages"), &RenderingDevice::native_callback_add);
+	ClassDB::bind_method(D_METHOD("native_callback_get_version"), &RenderingDevice::native_callback_get_version);
 
 	ClassDB::bind_method(D_METHOD("get_perf_report"), &RenderingDevice::get_perf_report);
 
diff --git a/servers/rendering/rendering_device.h b/servers/rendering/rendering_device.h
index 38c4b14..e53d2fe 100644
--- a/servers/rendering/rendering_device.h
+++ b/servers/rendering/rendering_device.h
@@ -317,6 +317,21 @@ public:
 
 	Error driver_callback_add(RDD::DriverCallback p_callback, void *p_userdata, VectorView<CallbackResource> p_resources);
 
+	// Native callbacks for extensions: p_callback is a C function
+	// void (*)(const RenderingDeviceDriver::NativeCallbackInfo *p_info, void *p_userdata), run with the native
+	// command list at this point of the render graph, with p_textures in the states p_usages ask for
+	// (CALLBACK_RESOURCE_USAGE_TEXTURE_SAMPLE, _STORAGE_IMAGE_READ, _STORAGE_IMAGE_READ_WRITE, _COPY_FROM, _COPY_TO).
+	typedef void (*NativeCallback)(const RDD::NativeCallbackInfo *p_info, void *p_userdata);
+	Error native_callback_add(uint64_t p_callback, uint64_t p_userdata, const TypedArray<RID> &p_textures, const PackedInt32Array &p_usages);
+	// 1 when this rendering driver supports native callbacks (D3D12), 0 otherwise.
+	int native_callback_get_version() const;
+
+private:
+	struct NativeCallbackPayload;
+	static void _native_callback_run(RDD *p_driver, RDD::CommandBufferID p_command_buffer, void *p_userdata);
+
+public:
+
 	/*****************/
 	/**** TEXTURE ****/
 	/*****************/
diff --git a/servers/rendering/rendering_device_driver.h b/servers/rendering/rendering_device_driver.h
index 103bd99..3164f8f 100644
--- a/servers/rendering/rendering_device_driver.h
+++ b/servers/rendering/rendering_device_driver.h
@@ -816,6 +816,41 @@ public:
 
 	typedef void (*DriverCallback)(RenderingDeviceDriver *p_driver, CommandBufferID p_command_buffer, void *p_userdata);
 
+	// Native callbacks: an extension records its own GPU work (e.g. an upscaler library) into the command buffer
+	// the engine is recording, at the callback's place in the render graph. Plain C layout shared with
+	// extensions (RenderingDevice::native_callback_add); append-only, struct_size tells versions apart.
+	enum NativeApi {
+		NATIVE_API_NONE = 0,
+		NATIVE_API_D3D12 = 1,
+	};
+
+	enum NativeBarrierModel {
+		NATIVE_BARRIERS_LEGACY_STATES = 0, // states[] are D3D12_RESOURCE_STATES.
+		NATIVE_BARRIERS_ENHANCED_LAYOUTS = 1, // states[] are D3D12_BARRIER_LAYOUT.
+	};
+
+	struct NativeCallbackInfo {
+		uint32_t struct_size = sizeof(NativeCallbackInfo);
+		uint32_t api = NATIVE_API_NONE;
+		uint64_t device = 0; // ID3D12Device*.
+		uint64_t command_queue = 0; // ID3D12CommandQueue* the command list goes to.
+		uint64_t command_list = 0; // ID3D12GraphicsCommandList* being recorded.
+		uint32_t barrier_model = NATIVE_BARRIERS_LEGACY_STATES;
+		uint32_t resource_count = 0;
+		const uint64_t *resources = nullptr; // ID3D12Resource* of each texture handed over, in order.
+		const uint32_t *states = nullptr; // The state or layout each one is in; the callback must leave it there.
+	};
+
+	static const uint32_t NATIVE_CALLBACK_MAX_RESOURCES = 16;
+
+	// Puts the textures in the states their layouts ask for and fills r_info (r_resources and r_states hold
+	// p_textures.size() entries). False if this driver can't hand its command buffer to native code.
+	virtual bool command_native_callback_begin(CommandBufferID p_cmd_buffer, VectorView<TextureID> p_textures, VectorView<TextureLayout> p_layouts, NativeCallbackInfo &r_info, uint64_t *r_resources, uint32_t *r_states) { return false; }
+	// Forgets the command buffer's cached state (descriptor heaps, root signatures, pipelines, dynamic state),
+	// which the native code may have changed.
+	virtual void command_native_callback_end(CommandBufferID p_cmd_buffer) {}
+	virtual bool native_callbacks_supported() const { return false; }
+
 	/*****************/
 	/**** QUERIES ****/
 	/*****************/
