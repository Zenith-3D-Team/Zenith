diff --git a/servers/rendering/rendering_device.cpp b/servers/rendering/rendering_device.cpp
index 7574038..4578d70 100644
--- a/servers/rendering/rendering_device.cpp
+++ b/servers/rendering/rendering_device.cpp
@@ -1235,6 +1235,87 @@ Error RenderingDevice::driver_callback_add(RDD::DriverCallback p_callback, void
 	return OK;
 }
 
+struct RenderingDevice::NativeCallbackPayload {
+	NativeCallback callback = nullptr;
+	void *userdata = nullptr;
+	uint64_t device = 0;
+	uint64_t command_queue = 0;
+	uint32_t count = 0;
+	RDD::TextureID textures[RDD::NATIVE_CALLBACK_MAX_RESOURCES];
+	RDD::TextureLayout layouts[RDD::NATIVE_CALLBACK_MAX_RESOURCES];
+};
+
+int RenderingDevice::native_callback_get_version() const {
+	return driver->native_callbacks_supported() ? 1 : 0;
+}
+
+Error RenderingDevice::native_callback_add(uint64_t p_callback, uint64_t p_userdata, const TypedArray<RID> &p_textures, const PackedInt32Array &p_usages) {
+	ERR_RENDER_THREAD_GUARD_V(ERR_UNAVAILABLE);
+	ERR_FAIL_COND_V_MSG(!driver->native_callbacks_supported(), ERR_UNAVAILABLE, "Native callbacks are not supported by this rendering driver.");
+	ERR_FAIL_COND_V(p_callback == 0, ERR_INVALID_PARAMETER);
+	ERR_FAIL_COND_V(p_textures.size() != p_usages.size(), ERR_INVALID_PARAMETER);
+	ERR_FAIL_COND_V(p_textures.size() > (int)RDD::NATIVE_CALLBACK_MAX_RESOURCES, ERR_INVALID_PARAMETER);
+
+	NativeCallbackPayload *payload = memnew(NativeCallbackPayload);
+	payload->callback = (NativeCallback)p_callback;
+	payload->userdata = (void *)p_userdata;
+	payload->device = driver->get_resource_native_handle(RDD::DRIVER_RESOURCE_LOGICAL_DEVICE, RDD::ID());
+	payload->command_queue = driver->get_resource_native_handle(RDD::DRIVER_RESOURCE_COMMAND_QUEUE, main_queue);
+	payload->count = p_textures.size();
+
+	CallbackResource resources[RDD::NATIVE_CALLBACK_MAX_RESOURCES];
+	for (uint32_t i = 0; i < payload->count; i++) {
+		RID rid = p_textures[i];
+		Texture *texture = texture_owner.get_or_null(rid);
+		CallbackResourceUsage usage = (CallbackResourceUsage)p_usages[i];
+		RDD::TextureLayout layout = RDD::TEXTURE_LAYOUT_UNDEFINED;
+		switch (usage) {
+			case CALLBACK_RESOURCE_USAGE_TEXTURE_SAMPLE:
+				layout = RDD::TEXTURE_LAYOUT_SHADER_READ_ONLY_OPTIMAL;
+				break;
+			case CALLBACK_RESOURCE_USAGE_STORAGE_IMAGE_READ:
+			case CALLBACK_RESOURCE_USAGE_STORAGE_IMAGE_READ_WRITE:
+				layout = RDD::TEXTURE_LAYOUT_STORAGE_OPTIMAL;
+				break;
+			case CALLBACK_RESOURCE_USAGE_COPY_FROM:
+				layout = RDD::TEXTURE_LAYOUT_COPY_SRC_OPTIMAL;
+				break;
+			case CALLBACK_RESOURCE_USAGE_COPY_TO:
+				layout = RDD::TEXTURE_LAYOUT_COPY_DST_OPTIMAL;
+				break;
+			default:
+				break;
+		}
+		if (texture == nullptr || layout == RDD::TEXTURE_LAYOUT_UNDEFINED) {
+			memdelete(payload);
+			ERR_FAIL_V_MSG(ERR_INVALID_PARAMETER, vformat("Native callback texture %d is not a valid texture with a supported usage.", i));
+		}
+		resources[i] = { rid, CALLBACK_RESOURCE_TYPE_TEXTURE, usage };
+		payload->textures[i] = texture->driver_id;
+		payload->layouts[i] = layout;
+	}
+
+	Error err = driver_callback_add(_native_callback_run, payload, VectorView<CallbackResource>(resources, payload->count));
+	if (err != OK) {
+		memdelete(payload);
+	}
+	return err;
+}
+
+void RenderingDevice::_native_callback_run(RDD *p_driver, RDD::CommandBufferID p_command_buffer, void *p_userdata) {
+	NativeCallbackPayload *payload = (NativeCallbackPayload *)p_userdata;
+	uint64_t resources[RDD::NATIVE_CALLBACK_MAX_RESOURCES] = {};
+	uint32_t states[RDD::NATIVE_CALLBACK_MAX_RESOURCES] = {};
+	RDD::NativeCallbackInfo info;
+	info.device = payload->device;
+	info.command_queue = payload->command_queue;
+	if (p_driver->command_native_callback_begin(p_command_buffer, VectorView<RDD::TextureID>(payload->textures, payload->count), VectorView<RDD::TextureLayout>(payload->layouts, payload->count), info, resources, states)) {
+		payload->callback(&info, payload->userdata);
+		p_driver->command_native_callback_end(p_command_buffer);
+	}
+	memdelete(payload);
+}
