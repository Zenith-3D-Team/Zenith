; AMD FSR's window test (tools/godot/fsr_window_test.ps1): hook_test's project (copied in first) with this main
; scene, exported with Zenith's patched Godot template and vendor/amd beside the program. Nothing here ships.
config_version=5

[application]

config/name="Zenith FSR test"
run/main_scene="res://fsr_test.tscn"
config/features=PackedStringArray("4.7")

[audio]

driver/driver="Dummy"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=false

[rendering]

renderer/rendering_method="forward_plus"
rendering_device/driver.windows="d3d12"
